{
  "name": "otjang",
  "version": "0.8.0-beta",
  "private": true,
  "type": "commonjs",
  "description": "어울(EOUL, 가칭) 시험판: 기준으로 딱 하나 추천(검증 카탈로그), 옷장 기록, 살까 말까 판정, 3D 옷장. 서버 없이 동작한다.",
  "scripts": {
    "build": "node build.mjs",
    "build:empty": "WARDROBE=data/empty.json OUT=dist/otjang-empty.html node build.mjs",
    "assets": "node tools/gen-assets.mjs",
    "test": "node --test test/*.cjs",
    "check": "node tools/check.mjs",
    "golden": "node tools/golden.mjs",
    "compress": "node tools/compress-glb.mjs",
    "build:web": "WARDROBE=data/empty.json SPLIT_DIR=dist/web node build.mjs",
    "check:web": "node tools/check-web.mjs",
    "check:a11y": "node tools/check-a11y.mjs",
    "check:perf": "node tools/check-perf.mjs",
    "check:catalog": "node tools/validate-catalog.mjs",
    "recheck": "node tools/recheck.mjs"
  },
  "dependencies": {
    "three": "0.160.1"
  },
  "devDependencies": {
    "@gltf-transform/core": "4.5.1",
    "@gltf-transform/extensions": "4.5.1",
    "@gltf-transform/functions": "4.5.1",
    "axe-core": "4.10.3",
    "esbuild": "0.28.2",
    "meshoptimizer": "1.3.0",
    "playwright": "1.56.0"
  }
}
