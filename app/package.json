{
  "name": "otjang",
  "version": "0.5.0-beta",
  "private": true,
  "type": "commonjs",
  "description": "어울(EOUL, 가칭) 시험판: 옷장 기록, 사진 상태, 살까 말까 판정, 3D 옷장, 직접 넣는 상품 목록과 구매 추천. 서버 없이 동작한다.",
  "scripts": {
    "build": "node build.mjs",
    "build:empty": "WARDROBE=data/empty.json OUT=dist/otjang-empty.html node build.mjs",
    "assets": "node tools/gen-assets.mjs",
    "test": "node --test test/*.cjs",
    "check": "node tools/check.mjs",
    "golden": "node tools/golden.mjs",
    "compress": "node tools/compress-glb.mjs",
    "build:web": "WARDROBE=data/empty.json SPLIT_DIR=dist/web node build.mjs",
    "check:web": "node tools/check-web.mjs"
  },
  "dependencies": {
    "three": "0.160.1"
  },
  "devDependencies": {
    "esbuild": "0.28.2",
    "playwright": "1.56.0",
    "@gltf-transform/core": "4.5.1",
    "@gltf-transform/extensions": "4.5.1",
    "@gltf-transform/functions": "4.5.1",
    "meshoptimizer": "1.3.0"
  }
}
