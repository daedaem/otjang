# 어울 운영 설정. 이 파일을 같은 폴더의 .env로 복사해 값을 채우세요.
#   cp .env.example .env
# .env는 .gitignore에 들어 있어 저장소에 올라가지 않습니다. 값을 이 예시 파일에 적지 마세요.

# ── 꼭 채울 것 ─────────────────────────────────────────────
# Cloudflare Zero Trust → Networks → Tunnels에서 만든 터널의 토큰(긴 문자열).
TUNNEL_TOKEN=
# 사용자가 여는 https 주소. 메일 링크가 이 주소로 열려요. 예: https://app.example.kr
EOUL_PUBLIC_URL=
# 시험 기간에는 이 코드를 아는 사람만 가입해요. 공개 출시 때 비우세요.
EOUL_INVITE_CODE=

# ── 메일(이메일 확인·비밀번호 재설정) ───────────────────────
# off: 보내지 않음 / smtp: 아래 메일 계정으로 보냄. console은 개발용이라 운영에 쓰지 마세요.
EOUL_MAIL=off
EOUL_SMTP_HOST=
EOUL_SMTP_PORT=587
EOUL_SMTP_USER=
EOUL_SMTP_PASS=
EOUL_SMTP_FROM=

# ── 기능 ──────────────────────────────────────────────────
# 회원 코디. 규칙·신고 연락처·처리방침을 정한 뒤 on으로 바꾸세요.
EOUL_COMMUNITY=off
EOUL_COMMUNITY_MAX_MB=2048
# 가격 출처(네이버 쇼핑 검색 API). 비우면 연결하지 않아요.
EOUL_NAVER_CLIENT_ID=
EOUL_NAVER_CLIENT_SECRET=
# 앱을 다른 주소(예: GitHub Pages)에도 올렸다면 그 주소. 쉼표로 여러 개.
EOUL_ALLOWED_ORIGINS=
EOUL_SESSION_DAYS=60
# 서버 배경 지우기(U-2-Net). true로 바꾸고 다시 빌드한 뒤 모델을 받으세요(README 참고). 이미지가 약 240MB 커져요.
EOUL_WITH_PHOTO_MASK=false

# ── 백업(Litestream) ──────────────────────────────────────
# litestream.yml: 아래 폴더로 복제 / litestream-s3.yml: S3 호환 저장소로 복제
EOUL_BACKUP_CONFIG=litestream.yml
# 집 PC에서는 다른 디스크의 폴더를 권해요. Windows 예: D:/eoul-backups
EOUL_BACKUP_DIR=./backups
EOUL_S3_BUCKET=
EOUL_S3_ENDPOINT=
EOUL_S3_REGION=auto
EOUL_S3_ACCESS_KEY_ID=
EOUL_S3_SECRET_ACCESS_KEY=

# ── 보통은 그대로 두세요 ───────────────────────────────────
# 이 컴퓨터에서 확인할 때 여는 포트(http://localhost:8787)
EOUL_LOCAL_PORT=8787
# 터널 컨테이너의 고정 주소와 내부 네트워크. 집·회사 네트워크와 겹칠 때만 바꾸세요(세 값을 함께).
EOUL_EDGE_SUBNET=172.31.87.0/24
EOUL_EDGE_AUTO_RANGE=172.31.87.128/25
EOUL_TUNNEL_ADDRESS=172.31.87.10
